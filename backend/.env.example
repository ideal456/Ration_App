# Database Configuration (for local development or production)
# Option A: Single connection URL (Recommended for Railway/Render)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ration_db

# Option B: Individual connection parameters
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ration_db

# Server Configuration
PORT=5000
